TASKPILOT_ENVIRONMENT=development
TASKPILOT_HOST=127.0.0.1
TASKPILOT_PORT=8000
TASKPILOT_DATABASE_URL=sqlite+aiosqlite:///./.taskpilot/taskpilot.db
TASKPILOT_CHECKPOINT_URL=.taskpilot/checkpoints.db
TASKPILOT_ALLOWED_REPOSITORY_ROOTS=./examples
TASKPILOT_POLICY_FILE=./config.example.yaml
TASKPILOT_LOG_LEVEL=INFO
TASKPILOT_LANGSMITH_ENABLED=false
TASKPILOT_DEMO_MODE=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=taskpilot-ai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPATIBLE_API_KEY=

# Docker Compose repository overlay inputs. Use an absolute repository path.
TASKPILOT_REPOSITORY_PATH=
TASKPILOT_POLICY_PATH=./.taskpilot/config.yaml
# On Linux, set these to `id -u` and `id -g` so repository writes retain your ownership.
TASKPILOT_HOST_UID=1000
TASKPILOT_HOST_GID=1000
