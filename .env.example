TASKPILOT_ENVIRONMENT=development
TASKPILOT_HOST=127.0.0.1
TASKPILOT_PORT=8000
TASKPILOT_DATABASE_URL=sqlite+aiosqlite:///./.taskpilot/taskpilot.db
TASKPILOT_CHECKPOINT_URL=.taskpilot/checkpoints.db
TASKPILOT_ALLOWED_REPOSITORY_ROOTS=./examples
TASKPILOT_POLICY_FILE=./config.example.yaml
TASKPILOT_LOG_LEVEL=INFO
TASKPILOT_LANGSMITH_ENABLED=false
TASKPILOT_DEMO_MODE=true
# Empty keeps local single-user mode. Entries may include a token and roles array.
TASKPILOT_AUTH_TOKENS=
# OIDC replaces opaque tokens when all three values below are set.
TASKPILOT_OIDC_ISSUER=
TASKPILOT_OIDC_AUDIENCE=
TASKPILOT_OIDC_JWKS_URL=
TASKPILOT_OIDC_ROLES_CLAIM=roles
# Leave approval role empty to permit every authenticated owner to approve.
TASKPILOT_APPROVAL_ROLE=
TASKPILOT_ADMIN_ROLE=admin
TASKPILOT_ARTIFACT_BACKEND=local
TASKPILOT_ARTIFACT_ROOT=.taskpilot/artifacts
TASKPILOT_ARTIFACT_S3_BUCKET=
TASKPILOT_ARTIFACT_S3_PREFIX=taskpilot
TASKPILOT_ARTIFACT_S3_ENDPOINT_URL=
TASKPILOT_ARTIFACT_S3_REGION=
TASKPILOT_OPERATION_ROOT=.taskpilot/operations
# embedded runs work in this process; api queues only; worker consumes only; all does both.
TASKPILOT_EXECUTION_MODE=embedded
TASKPILOT_WORKER_ID=
TASKPILOT_WORKER_LEASE_SECONDS=300
TASKPILOT_WORKER_POLL_SECONDS=0.5
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=taskpilot-ai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COMPATIBLE_API_KEY=

# Docker Compose repository overlay inputs. Use an absolute repository path.
TASKPILOT_REPOSITORY_PATH=
TASKPILOT_POLICY_PATH=./.taskpilot/config.yaml
# On Linux, set these to `id -u` and `id -g` so repository writes retain your ownership.
TASKPILOT_HOST_UID=1000
TASKPILOT_HOST_GID=1000
